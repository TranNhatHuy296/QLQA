<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FAF9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Thêm nhân viên mới"
            android:textColor="#1A1C1E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Avatar Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUploadAvatar"
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#C4C6CF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivAvatarPlaceholder"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="#43474E" />

                <TextView
                    android:id="@+id/tvAvatarLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tải ảnh đại diện"
                    android:textColor="#964900"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/ivStaffAvatarPreview"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Thông tin cơ bản"
            android:textColor="#1A1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_border"
            android:hint="Họ và tên"
            android:paddingHorizontal="16dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_border"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_border"
                android:hint="Số điện thoại"
                android:inputType="phone"
                android:paddingHorizontal="16dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_border"
                android:hint="Địa chỉ"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Công việc"
            android:textColor="#1A1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Vị trí"
            android:textColor="#43474E"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgPosition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/rbWaiter"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phục vụ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rbChef"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đầu bếp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rbSecurity"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bảo vệ" />

            <com.google.android.material.chip.Chip
                android:id="@+id/rbBarista"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pha chế" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Trạng thái hiện tại"
            android:textColor="#43474E"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgStaffStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPresent"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có mặt"
                app:chipIcon="@android:drawable/presence_online" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAbsent"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vắng mặt"
                app:chipIcon="@android:drawable/presence_busy" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNotStarted"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa bắt đầu ca"
                app:chipIcon="@android:drawable/presence_invisible" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mã nhân viên (Tự động)"
            android:textColor="#43474E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvEmployeeCode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="#EFEDF0"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="NV-2024-001"
            android:textColor="#43474E"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Ca làm việc"
            android:textColor="#1A1C1E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#C4C6CF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <CheckBox
                    android:id="@+id/cbMorningShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Ca sáng (06:00 - 14:00)" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#C4C6CF" />

                <CheckBox
                    android:id="@+id/cbAfternoonShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Ca chiều (14:00 - 22:00)" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#C4C6CF" />

                <CheckBox
                    android:id="@+id/cbNightShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="Ca tối (22:00 - 06:00)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveStaff"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:text="Lưu thông tin"
            android:textAllCaps="false"
            app:backgroundTint="#FF851B"
            app:cornerRadius="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="#43474E" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
